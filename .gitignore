# Secrets (API keys). Never commit.
.env
.env.*
!.env.example

# Raw datasets: no redistribution rights (decision D-003). Only manifests are tracked.
data/*
!data/manifests/

# Run artifacts may contain derived data from raw records; publish only reviewed aggregates.
# Workflow checkpoints, operation receipts, and spend records are sensitive local artifacts.
runs/
ingestion-backup-*/
*.sqlite
*.sqlite-journal
*.sqlite-wal

# Sealed test instances and answer keys never enter version control or agent-visible paths.
benchmarks/sealed/

# Python / tooling
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/
build/
dist/

# Sprint plans stay local and are not version-controlled.
SPRINT_*.md
sprints/
