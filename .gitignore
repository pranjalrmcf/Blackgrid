# Secrets (API keys). Never commit.
.env
.env.*

# Raw datasets: no redistribution rights (decision D-003). Only manifests are tracked.
data/*
!data/manifests/

# Run artifacts may contain derived data from raw records; publish only reviewed aggregates.
runs/

# Sealed test instances and answer keys never enter version control or agent-visible paths.
benchmarks/sealed/

# Python / tooling
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/
build/
dist/
