# Copy to .env (git-ignored) and fill in. Only used in live mode (--allow-paid).
OPEN_ROUTER_API_KEY=your-openrouter-key-here
# Any model ID from https://openrouter.ai/models ; overrides llm.model in the config.
OPEN_ROUTER_MODEL=anthropic/claude-haiku-5.5

# Optional deployment entry point: python -m blackgrid.operations serve
# These are process environment variables, not automatically loaded from this file.
# The Compose service supplies explicit production defaults and never injects this .env.
# BLACKGRID_ENV=development
# BLACKGRID_CONFIG=C:/Blackgrid/configs/collegemsg_sprint01.json
# BLACKGRID_DATA_ROOT=C:/Blackgrid
# BLACKGRID_RUNS_DIR=C:/Blackgrid/runs
# BLACKGRID_PORT=8765
# BLACKGRID_SHUTDOWN_GRACE_SECONDS=30
# BLACKGRID_CAPABILITIES=community

# Optional API listener: python -m blackgrid.operations api
# Provision locally with scripts/create_api_client.py; never commit .secrets/.
# BLACKGRID_API_CREDENTIALS_FILE=C:/Blackgrid/.secrets/clients.json
# BLACKGRID_API_HOST=127.0.0.1
# BLACKGRID_API_ALLOWED_HOSTS=127.0.0.1,localhost
# Non-loopback API binding requires both operator-provided TLS files:
# BLACKGRID_API_TLS_CERTFILE=/run/secrets/api-cert.pem
# BLACKGRID_API_TLS_KEYFILE=/run/secrets/api-key.pem
# Optional retained live authorization (no provider calls at startup):
# BLACKGRID_API_LIVE_POLICY_FILE=/run/secrets/live-policy.json
